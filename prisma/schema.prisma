generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Consulta {
  id                Int      @id @default(autoincrement())
  semanaLunes       String   @map("semana_lunes")
  taller            String
  fechaConfirmacion String   @map("fecha_confirmacion")
  nombreCliente     String   @map("nombre_cliente")
  tituloPedido      String   @map("titulo_pedido")
  descripcionPieza  String?  @map("descripcion_pieza")
  fechaCompromiso   String?  @map("fecha_compromiso")
  asesora           String
  etapa             Int?
  comentarios       String?
  creadoEn          DateTime @default(now()) @map("creado_en")

  @@map("consultas_produccion")
}
